# ─────────────────────────────────────────────
# AMBIENTE
# ─────────────────────────────────────────────

# Define o ambiente de execução.
# Em 'production': o bot processa todas as mensagens, inclusive acumuladas antes do startup.
# Em qualquer outro valor (ex: 'development'): mensagens anteriores ao startup são ignoradas,
# evitando spam em testes.
NODE_ENV=production

# ─────────────────────────────────────────────
# EVOLUTION API (gateway WhatsApp)
# ─────────────────────────────────────────────

# Chave de acesso à Evolution API (gerada durante o setup da Evolution)
EVOLUTION_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Nome da instância WhatsApp criada na Evolution API
EVOLUTION_INSTANCE=minha-instancia

# URL pública onde a Evolution API alcança o bot.
# Em Docker, usar o nome do serviço: http://bot:3000
# Em desenvolvimento local: http://host.docker.internal:3000 ou URL pública (ngrok etc.)
BOT_WEBHOOK_URL=http://bot:3000

# ─────────────────────────────────────────────
# SEGURANÇA
# ─────────────────────────────────────────────

# Segredo compartilhado entre Evolution API e bot (header x-api-key).
# Gerar com: openssl rand -hex 32
WEBHOOK_TOKEN=change-me-generate-with-openssl-rand-hex-32

# ─────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────

# Chave da OpenAI (usada para chat, Whisper e GPT-4o Vision)
OPENAI_API_KEY=sk-proj-...

# Modelo padrão para o chat do bot. Opções: gpt-4o-mini (barato), gpt-4o (melhor)
OPENAI_MODEL=gpt-4o-mini

# Idioma para transcrição de áudio via Whisper (código BCP-47, ex: pt, en, es)
WHISPER_LANGUAGE=pt

# ─────────────────────────────────────────────
# BANCO DE DADOS (PostgreSQL)
# ─────────────────────────────────────────────

# Usada pela Evolution API internamente
POSTGRES_USER=evolution
POSTGRES_PASSWORD=change-me-strong-random-password
POSTGRES_DB=evolution

# Usada pelo bot e pelo CRM (banco 'crm' no mesmo Postgres)
DATABASE_URL=postgresql://evolution:change-me-strong-random-password@postgres:5432/crm

# ─────────────────────────────────────────────
# BOT — COMPORTAMENTO
# ─────────────────────────────────────────────

# Porta HTTP do servidor do bot
PORT=3000

# Número máximo de mensagens mantidas no histórico por conversa (pares usuário/assistente)
MAX_HISTORY=10

# Delay em ms entre envios no broadcast para evitar bloqueio pelo WhatsApp
BROADCAST_DELAY_MS=1000

# ─────────────────────────────────────────────
# ATENDIMENTO HUMANO
# ─────────────────────────────────────────────

# Tempo (minutos) que o bot fica em silêncio após uma transferência explícita para humano
# (disparada pelo token __TRANSFER__ ou pelo comando /bot on).
# Após esse tempo, o bot retoma automaticamente. 0 = indefinido (nunca retoma sozinho).
HUMAN_TAKEOVER_TIMEOUT_MINUTES=30

# Tempo (minutos) que o bot pausa automaticamente quando o operador responde manualmente
# pelo WhatsApp (mensagem fromMe que não é um comando).
# Permite que o operador continue a conversa sem o bot interferir.
HUMAN_REPLY_PAUSE_MINUTES=10

# ─────────────────────────────────────────────
# GOOGLE CALENDAR (agendamentos)
# ─────────────────────────────────────────────

# ID do Google Calendar onde os agendamentos serão criados
GOOGLE_CALENDAR_ID=seu-calendario@group.calendar.google.com

# Credenciais da Service Account Google em JSON (cole o conteúdo inteiro do google-credentials.json aqui).
# Quando definido, dispensa o arquivo físico e o GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"","private_key_id":"","private_key":"","client_email":"","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":""}

# Caminho para o JSON da Service Account Google (alternativa local ao GOOGLE_CREDENTIALS_JSON)
# GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json

# ─────────────────────────────────────────────
# MERCADO PAGO (Pix)
# ─────────────────────────────────────────────

# Token de acesso do Mercado Pago (começa com APP_USR-)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Segredo para validar a assinatura do webhook do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret

# ─────────────────────────────────────────────
# CRM / DASHBOARD
# ─────────────────────────────────────────────

# Segredo do NextAuth (JWT). Gerar com: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# URL base do CRM (usada pelo NextAuth para callbacks de autenticação)
NEXTAUTH_URL=http://localhost:3001

# Credenciais do usuário admin criado no primeiro seed do banco
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=senha-admin-aqui

# URL interna do bot, usada pelo CRM para disparar comandos (notify, broadcast, bot-on).
# Em Docker: http://bot:3000. Em desenvolvimento local: http://localhost:3000
BOT_INTERNAL_URL=http://bot:3000
