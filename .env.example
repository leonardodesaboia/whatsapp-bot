# Ambiente (production ignora mensagens acumuladas antes do startup)
NODE_ENV=production

# Evolution API
EVOLUTION_API_KEY=change-me-generate-with-openssl-rand-hex-32
EVOLUTION_INSTANCE=minha-instancia

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# Webhook (segredo compartilhado entre Evolution API e bot)
WEBHOOK_TOKEN=change-me-generate-with-openssl-rand-hex-32

# PostgreSQL (usado internamente pela Evolution API)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=change-me-strong-random-password
POSTGRES_DB=evolution

# Bot
MAX_HISTORY=10
PORT=3000

# URL pública onde a Evolution API alcança o bot (usar nome do serviço Docker internamente)
BOT_WEBHOOK_URL=http://bot:3000

# Transferência para humano
HUMAN_TAKEOVER_TIMEOUT_MINUTES=30

# Google Calendar (agendamento)
GOOGLE_CALENDAR_ID=seu-calendario@group.calendar.google.com
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json

# Mercado Pago (Pix)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret

# Transcrição de áudio (Whisper)
WHISPER_LANGUAGE=pt

# Broadcast
BROADCAST_DELAY_MS=1000

# CRM / Funil de Vendas
DATABASE_URL=postgresql://evolution:change-me-strong-random-password@postgres:5432/crm
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3001
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=senha-admin-aqui
