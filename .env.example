# Evolution API
EVOLUTION_API_KEY=change-me-generate-with-openssl-rand-hex-32
EVOLUTION_INSTANCE=minha-instancia

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# Webhook (segredo compartilhado entre Evolution API e bot)
WEBHOOK_TOKEN=change-me-generate-with-openssl-rand-hex-32

# PostgreSQL (usado internamente pela Evolution API)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=change-me-strong-random-password
POSTGRES_DB=evolution

# Bot
MAX_HISTORY=10
PORT=3000

# URL pública onde a Evolution API alcança o bot (usar nome do serviço Docker internamente)
BOT_WEBHOOK_URL=http://bot:3000
